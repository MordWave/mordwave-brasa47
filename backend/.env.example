NODE_ENV=development
PORT=3000

# Frontend origin allowed to call this API (CORS)
FRONTEND_URL=http://localhost:5173

# Local/dev Postgres — used only when DATABASE_URL below is not set
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=brasa47

# Supabase (or any hosted Postgres): when set, this takes priority over the
# DB_* vars above and SSL is enabled automatically.
# Get it from Supabase: Project Settings -> Database -> Connection string (URI).
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
