NODE_ENV=development
PORT=3000

# Frontend origin(s) allowed to call this API (CORS) — comma-separated.
# Add a LAN origin (e.g. http://192.168.1.23:5173, from `ipconfig getifaddr
# en0`) to test from a phone on the same Wi-Fi as the Mac.
FRONTEND_URL=http://localhost:5173

# Local/dev Postgres — used only when DATABASE_URL below is not set
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=brasa47

# Hosted Postgres (Railway in production): when set, this takes priority over
# the DB_* vars above and SSL is enabled automatically. On Railway it is a
# Variable Reference to the Postgres service (private network), never a copied
# value.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/railway

# Postgres pool / timeouts (all optional — defaults shown). Invalid values
# stop the app at startup. DB_POOL_MAX is per app instance: with N replicas
# the database sees N x this many connections. DB_QUERY_TIMEOUT_MS must be
# greater than DB_STATEMENT_TIMEOUT_MS. The TypeORM CLI (migrations) ignores
# all of these on purpose, so DDL never inherits a short statement timeout.
# After the first deploy, verify statement_timeout actually reaches the
# session (read-only `SHOW statement_timeout;` over an app connection) — see
# src/config/database-operational.config.ts.
# DB_POOL_MAX=5
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_QUERY_TIMEOUT_MS=20000

# JWT auth — required. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value — this file only holds a placeholder.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Dev admin user for `npm run seed` — required only to create it. If either
# is unset, the seed skips creating the admin (never a default/predictable
# login). Never commit real values here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Media: Railway Bucket (S3 API) behind GET /media/<key>.
# Public origin of THIS API (not the bucket, which is private), used to turn a
# stored storage key into https://<origin>/media/<key>. On Railway set it to a
# reference to the service's public domain (https://${{RAILWAY_PUBLIC_DOMAIN}}),
# never a hardcoded value. REQUIRED for image/logo uploads: while it is unset
# they answer 503 IMAGE_STORAGE_UNAVAILABLE (a key whose URL can't be built
# would make the image vanish). Rows with only a legacy URL are unaffected.
# Must be https (http only for localhost), without credentials, query or
# fragment; a malformed value fails the boot.
MEDIA_PUBLIC_BASE_URL=

# Railway Bucket (S3 API) — read path behind GET /media/<key>. On Railway
# these are Variable References to the bucket service (never copied values).
# Leave AWS_ENDPOINT_URL and AWS_S3_BUCKET_NAME unset to keep /media disabled
# (it answers 503); if either is set, ALL FIVE below are required and
# malformed values fail the boot. AWS_S3_FORCE_PATH_STYLE is optional
# ("true" | "false", default false = virtual-hosted-style, Railway's default;
# older buckets may need "true" — see the bucket's Credentials tab).
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FORCE_PATH_STYLE=
