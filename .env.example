# Base URL of the NestJS backend (see /backend). Falls back to
# http://localhost:3000 if unset — this file is only needed to point at a
# non-default backend (e.g. once it's deployed).
VITE_API_URL=http://localhost:3000

# Public identifier (Business.slug in the backend) for the menu this site
# shows. Falls back to 'brasa-47' if unset — change it when deploying this
# same frontend for a different restaurant sharing the API.
VITE_BUSINESS_SLUG=brasa-47
