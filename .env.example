# Base URL of the NestJS backend (see /backend). Falls back to
# http://localhost:3000 if unset — this file is only needed to point at a
# non-default backend (e.g. once it's deployed).
#
# To test from a phone on the same Wi-Fi as your Mac, use the Mac's LAN IP
# instead of localhost (run `ipconfig getifaddr en0` to get it) — a phone
# can't resolve "localhost" to the Mac. Also update backend/.env's
# FRONTEND_URL to include the matching LAN origin (see that file).
#   VITE_API_URL=http://192.168.1.23:3000
VITE_API_URL=http://localhost:3000

# Fallback only — the real QR flow (scan → POST /table-sessions/join)
# resolves businessSlug dynamically from the table's own business, never
# from this var. Only used if menuApi is ever called outside that flow
# (e.g. exercising it directly during development).
VITE_BUSINESS_SLUG=brasa-47

# Canonical customer-facing origin encoded into each table's printed QR
# code. Falls back to window.location.origin if unset, which is fine for a
# single-deployment demo but wrong once the admin panel and the
# customer-facing site are ever viewed from different origins.
#
# For phone testing over LAN, use the Mac's LAN IP here too — a QR
# encoding "localhost" would only ever point the phone back at itself.
#   VITE_PUBLIC_URL=http://192.168.1.23:5173
VITE_PUBLIC_URL=http://localhost:5173
